{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "npm start",
    "restartPolicyMaxRetries": 10,
    "healthchecks": {
      "enabled": true,
      "interval": 10,
      "path": "/api/health",
      "timeout": 5
    }
  }
}
